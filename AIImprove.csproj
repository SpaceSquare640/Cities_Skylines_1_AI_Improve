<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>AIImprove</AssemblyName>
    <RootNamespace>AIImprove</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- The settings page header reads the version back at runtime (see
         SettingsPageUI.GetVersionString). GenerateAssemblyInfo used to be false with no manual
         AssemblyInfo.cs anywhere, so no version attribute was emitted at all and the header showed
         "Version 0.0.0" (2026-08-15).
         "用 GitHub commit 作版本標準" (2026-08-15): the version is now derived from git rather
         than hand-maintained here - see the SetVersionFromGit target below. VersionPrefix is only
         the fallback used when git isn't available (source zip download, no git on PATH). -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <VersionPrefix>1.0.0</VersionPrefix>
    <!-- The SDK otherwise appends the full 40-char commit SHA onto InformationalVersion, on top of
         the short hash SetVersionFromGit already puts there - which is what the settings page
         displays, so it would read "1.0.59+ee242bb.ee242bb25d75...". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Where the compiled DLL is auto-copied to after each build, so the game can load it directly. -->
    <CSDataPath>$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Addons\Mods\AIImprove</CSDataPath>
    <!-- Cities: Skylines install folder. Override in a local .user file if your install path differs. -->
    <CSInstallPath>H:\SteamLibrary\steamapps\common\Cities_Skylines</CSInstallPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Game managed assemblies. HintPath points at the actual game install; not copied to output. -->
    <Reference Include="ICities">
      <HintPath>$(CSInstallPath)\Cities_Data\Managed\ICities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ColossalManaged">
      <HintPath>$(CSInstallPath)\Cities_Data\Managed\ColossalManaged.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(CSInstallPath)\Cities_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(CSInstallPath)\Cities_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- CitiesHarmony.API: thin wrapper that waits for the CitiesHarmony workshop mod to load real Harmony at
         runtime, AND bundles its own compile-time Harmony types (HarmonyLib namespace). Do not also add a
         separate Lib.Harmony package reference - it defines the same "Harmony" type and causes CS0433. -->
    <PackageReference Include="CitiesHarmony.API" Version="2.2.0" />
  </ItemGroup>

  <!-- "用 GitHub commit 作版本標準" (2026-08-15): derives the version from git history instead of a
       hand-bumped number, so what the settings page shows always maps back to an exact commit.

         AssemblyVersion / FileVersion : 1.0.<commit count>   (must be numeric, hashes are illegal here)
         InformationalVersion          : <commit date> (<short hash>[-dirty])

       InformationalVersion is what the settings page displays. It leads with the commit date
       because "when was this last updated" is what a player actually wants to know (2026-08-15,
       per user request); the short hash follows so a bug report still pins down exact source.
       "-dirty" marks a build made with uncommitted changes, so a local test build is never
       mistaken for a released one.

       ContinueOnError + the HasGit guard keep this working where git isn't usable at all (source
       zip, no git on PATH, build server without the .git folder) - it just falls back to the
       VersionPrefix above rather than failing the build. -->
  <Target Name="SetVersionFromGit" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
      <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
    </Exec>
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
    </Exec>
    <!-- Committer date of HEAD. This is what the settings page actually shows - "last updated"
         reads far more meaningfully to a player than a commit count, and matches how Content
         Manager itself labels mods. The hash stays alongside it for bug reports. -->
    <!-- The percent needs escaping twice over: %25 gets MSBuild to emit a literal '%', and the
         doubled '%%' gets cmd.exe to pass one through instead of treating it as an environment
         variable reference and swallowing it (which left git with a format of just "cd", exit 128).
         Date mode is git's built in "short" rather than an explicit strftime string, so only this
         one percent needs escaping at all. -->
    <Exec Command="git log -1 --format=%25%25cd --date=short" ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitDate" />
      <Output TaskParameter="ExitCode" PropertyName="GitDateExitCode" />
    </Exec>
    <!-- Non-empty output here means tracked files differ from HEAD. -->
    <Exec Command="git status --porcelain --untracked-files=no" ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDirtyFiles" />
    </Exec>

    <PropertyGroup>
      <HasGit Condition="'$(GitExitCode)' == '0' AND '$(GitDateExitCode)' == '0' AND '$(GitCommitCount)' != '' AND '$(GitCommitHash)' != '' AND '$(GitCommitDate)' != ''">true</HasGit>
      <GitDirtySuffix Condition="'$(GitDirtyFiles)' != ''">-dirty</GitDirtySuffix>

      <Version Condition="'$(HasGit)' == 'true'">1.0.$(GitCommitCount)</Version>
      <AssemblyVersion Condition="'$(HasGit)' == 'true'">1.0.$(GitCommitCount).0</AssemblyVersion>
      <FileVersion Condition="'$(HasGit)' == 'true'">1.0.$(GitCommitCount).0</FileVersion>
      <!-- Displayed verbatim by the settings page: date first, commit hash in parentheses. -->
      <InformationalVersion Condition="'$(HasGit)' == 'true'">$(GitCommitDate) ($(GitCommitHash)$(GitDirtySuffix))</InformationalVersion>
    </PropertyGroup>

    <Message Importance="high" Condition="'$(HasGit)' == 'true'" Text="AIImprove version from git: $(InformationalVersion)" />
    <Message Importance="high" Condition="'$(HasGit)' != 'true'" Text="AIImprove version: git unavailable, falling back to $(VersionPrefix)" />
  </Target>

  <!-- Copy the built DLL straight into the local Mods folder so the game picks it up on next launch. -->
  <Target Name="CopyToMods" AfterTargets="Build">
    <MakeDir Directories="$(CSDataPath)" Condition="!Exists('$(CSDataPath)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CSDataPath)" />
  </Target>

</Project>
